# YOLOv8n exported to ONNX by triton/scripts/export_model.py (opset 12, static 640x640).
# The detector sends one letterboxed RGB frame and decodes output0 itself (no NMS here).
name: "yolov8n"
backend: "onnxruntime"
max_batch_size: 0

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 1, 3, 640, 640 ]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ 1, 84, 8400 ]
  }
]

instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]
