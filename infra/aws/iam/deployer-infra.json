{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NetworkAndInstances",
      "Effect": "Allow",
      "Action": "ec2:*",
      "Resource": "*"
    },
    {
      "Sid": "ReadOnlyLoadBalancingAndScaling",
      "Effect": "Allow",
      "Action": ["elasticloadbalancing:Describe*", "autoscaling:Describe*"],
      "Resource": "*"
    },
    {
      "Sid": "EksOnlyMiniEyesClusters",
      "Effect": "Allow",
      "Action": "eks:*",
      "Resource": [
        "arn:aws:eks:ap-southeast-1:*:cluster/minieyes-*",
        "arn:aws:eks:ap-southeast-1:*:nodegroup/minieyes-*/*/*",
        "arn:aws:eks:ap-southeast-1:*:addon/minieyes-*/*/*",
        "arn:aws:eks:ap-southeast-1:*:access-entry/minieyes-*/*",
        "arn:aws:eks:ap-southeast-1:*:podidentityassociation/minieyes-*/*",
        "arn:aws:eks:ap-southeast-1:*:fargateprofile/minieyes-*/*/*"
      ]
    },
    {
      "Sid": "EksDiscovery",
      "Effect": "Allow",
      "Action": ["eks:List*", "eks:Describe*", "eks:AssociateAccessPolicy", "eks:DisassociateAccessPolicy"],
      "Resource": "*"
    },
    {
      "Sid": "EcrOnlyMiniEyesRepositories",
      "Effect": "Allow",
      "Action": "ecr:*",
      "Resource": "arn:aws:ecr:ap-southeast-1:*:repository/minieyes*"
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken", "ecr:DescribeRegistry", "ecr:DescribeRepositories"],
      "Resource": "*"
    },
    {
      "Sid": "EksLogGroups",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": "arn:aws:logs:ap-southeast-1:*:log-group:/aws/eks/minieyes-*"
    },
    {
      "Sid": "LogsDiscovery",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogGroups", "logs:ListTagsForResource"],
      "Resource": "*"
    },
    {
      "Sid": "KmsCreateOnlyTaggedKeys",
      "Effect": "Allow",
      "Action": ["kms:CreateKey", "kms:TagResource"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestTag/Project": "minieyes"}}
    },
    {
      "Sid": "KmsUseOnlyMiniEyesKeys",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey", "kms:GetKeyPolicy", "kms:PutKeyPolicy", "kms:GetKeyRotationStatus",
        "kms:EnableKeyRotation", "kms:ScheduleKeyDeletion", "kms:ListResourceTags",
        "kms:UntagResource", "kms:CreateGrant", "kms:Encrypt", "kms:Decrypt",
        "kms:GenerateDataKey*", "kms:CreateAlias", "kms:DeleteAlias"
      ],
      "Resource": "arn:aws:kms:ap-southeast-1:*:key/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/Project": "minieyes"}}
    },
    {
      "Sid": "KmsAliases",
      "Effect": "Allow",
      "Action": ["kms:CreateAlias", "kms:DeleteAlias"],
      "Resource": ["arn:aws:kms:ap-southeast-1:*:alias/minieyes-*", "arn:aws:kms:ap-southeast-1:*:alias/eks/minieyes-*"]
    },
    {
      "Sid": "KmsDiscovery",
      "Effect": "Allow",
      "Action": ["kms:ListKeys", "kms:ListAliases"],
      "Resource": "*"
    },
    {
      "Sid": "TerraformStateBucket",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::minieyes-tfstate-*", "arn:aws:s3:::minieyes-tfstate-*/*"]
    },
    {
      "Sid": "ParametersAmiLookupAndProjectSecrets",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath", "ssm:PutParameter",
        "ssm:DeleteParameter", "ssm:AddTagsToResource", "ssm:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:ssm:ap-southeast-1:*:parameter/minieyes/*",
        "arn:aws:ssm:ap-southeast-1::parameter/aws/service/*"
      ]
    },
    {
      "Sid": "BudgetAlarms",
      "Effect": "Allow",
      "Action": [
        "budgets:ViewBudget", "budgets:ModifyBudget", "budgets:ListTagsForResource",
        "budgets:TagResource", "budgets:UntagResource"
      ],
      "Resource": "*"
    }
  ]
}
