apiVersion: v1
kind: Secret
metadata:
  name: gitops-repo
  namespace: {{ argocd_namespace }}
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  type: git
  url: {{ argocd_gitops_repo_url }}
{% if argocd_gitops_repo_private | bool %}
  sshPrivateKey: |
    {{ argocd_gitops_deploy_key | trim | indent(4) }}
{% endif %}
