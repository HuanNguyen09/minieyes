apiVersion: v1
kind: Secret
metadata:
  name: gitops-repo
  namespace: {{ argocd_namespace }}
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
# `data`, not `stringData`: the API server never stores stringData, so `kubectl apply` would
# report "configured" on every run and break idempotence.
data:
  type: {{ 'git' | b64encode }}
  url: {{ argocd_gitops_repo_url | b64encode }}
{% if argocd_gitops_repo_private | bool %}
  sshPrivateKey: {{ (argocd_gitops_deploy_key | trim + '\n') | b64encode }}
{% endif %}
